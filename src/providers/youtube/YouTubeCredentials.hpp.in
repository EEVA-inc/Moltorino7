#pragma once

#include <QString>

namespace chatterino::youtube::credentials {

#cmakedefine01 MOLTORINO_YOUTUBE_DIRECT_READ

inline constexpr bool directReadEnabled()
{
    return MOLTORINO_YOUTUBE_DIRECT_READ != 0;
}

inline const QString &readRoot()
{
    static const QString value =
        QStringLiteral("@MOLTORINO_YOUTUBE_READ_ROOT@");
    return value;
}

inline const QString &oauthClientID()
{
    static const QString value =
        QStringLiteral("@MOLTORINO_YOUTUBE_OAUTH_CLIENT_ID@");
    return value;
}

inline const QString &oauthClientSecret()
{
    static const QString value =
        QStringLiteral("@MOLTORINO_YOUTUBE_OAUTH_CLIENT_SECRET@");
    return value;
}

}
